NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-local-development-secret

# Optional approved bank. Relative paths are resolved from the Back directory.
# DIAGNOSTIC_QUESTIONS_FILE=docs/diagnostic-questions.json

